{
	"name": "keystone-app",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"wasm": "node ../wasm/build.mjs",
		"predev": "npm run wasm",
		"dev": "vite dev",
		"prebuild": "npm run wasm",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"precheck": "npm run wasm",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"pretest": "npm run wasm",
		"test": "vitest run"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"vitest": "^4.1.12"
	},
	"dependencies": {
		"@capacitor/android": "^8.4.1",
		"@capacitor/app": "^8.1.0",
		"@capacitor/cli": "^7.6.7",
		"@capacitor/core": "^8.4.1",
		"@capacitor/ios": "^8.4.1",
		"@noble/ciphers": "^2.2.0",
		"@noble/curves": "^2.2.0",
		"@noble/hashes": "^2.2.0"
	}
}
